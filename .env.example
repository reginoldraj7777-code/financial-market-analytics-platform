# Optional Snowflake configuration example.
# Copy values into your local environment. Never commit real credentials.
SNOWFLAKE_ACCOUNT=your_account_identifier
SNOWFLAKE_USER=your_user
SNOWFLAKE_WAREHOUSE=your_warehouse
SNOWFLAKE_DATABASE=your_database
SNOWFLAKE_SCHEMA=your_schema
SNOWFLAKE_ROLE=your_optional_role
# Configure one supported authentication method locally, for example:
# SNOWFLAKE_PASSWORD=your_local_secret
# SNOWFLAKE_AUTHENTICATOR=externalbrowser
